/* Dit maakt de achtergrond donker zoals op de foto */
body {
    background-color: #0b0c10;
    color: white;
    font-family: Arial, sans-serif;
    margin: 0;
}

/* Dit zorgt dat de menubalk netjes naast elkaar staat */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background-color: #1f2833;
}

header nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
}

/* Dit maakt een mooie groene knop */
.btn-green {
    background-color: #45a29e;
    color: white;
    padding: 10px 20px;
    text-decoration: none;
    border-radius: 5px;
    display: inline-block;
}
